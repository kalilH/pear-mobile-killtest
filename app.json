{
  "expo": {
    "name": "Hello Pear React Native",
    "slug": "hello-pear-react-native",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      ["pear-runtime-react-native"],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.hello-pear-react-native",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "RawDrop needs access to your local network to stream original 4K photos and files directly to your PC at maximum wire speed without using cellular data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.hellopearreactnative"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

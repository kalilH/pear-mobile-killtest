{
  "name": "hello-pear-react-native",
  "productName": "HelloPear",
  "version": "1.0.0",
  "upgrade": "pear://qt8z8mrmqamcmqke9sjmsb7nk737rao4bcocgmwgy5hxeb1y7sqy",
  "main": "index.ts",
  "scripts": {
    "bundle:bare": "npx bare-pack --host ios-arm64 --host ios-arm64-simulator --host ios-x64-simulator --host android-arm64 --linked --out ./src/worker.bundle.js ./workers/main.js",
    "bundle:react-native": "npx react-native bundle --platform ios --dev false --entry-file index.ts --bundle-output out/ios/HelloPear/app.bundle --assets-dest out/ios/HelloPear && npx react-native bundle --platform android --dev false --entry-file index.ts --bundle-output out/android/HelloPear/app.bundle --assets-dest out/android/HelloPear",
    "build": "npx pear-build --ios-arm64 ./out/ios/HelloPear --ios-arm64-simulator ./out/ios/HelloPear --ios-x64-simulator ./out/ios/HelloPear --android-arm64 ./out/android/HelloPear --package ./package.json --config ./pear.json --target dist",
    "update": "npm run bundle:bare && npm run bundle:react-native && npm run build",
    "prebuild": "npx expo prebuild",
    "ios": "node scripts/check-upgrade.js && expo run:ios",
    "android": "node scripts/check-upgrade.js && expo run:android",
    "production:ios": "npm run ios -- --configuration Release",
    "production:android": "npm run android -- --variant release",
    "lint": "lunte",
    "format": "prettier . --write",
    "test": "prettier . --check && lunte",
    "check:upgrade": "node scripts/check-upgrade.js",
    "killtest:android": "npm run bundle:bare && expo run:android --variant release --device",
    "killtest:ios": "npm run bundle:bare && expo run:ios --configuration Release --device",
    "gen:audio": "node scripts/gen-keepalive-audio.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hello-pear-react-native.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hello-pear-react-native/issues"
  },
  "homepage": "https://github.com/holepunchto/hello-pear-react-native",
  "dependencies": {
    "b4a": "^1.8.0",
    "expo": "^55.0.8",
    "expo-audio": "~55.0.18",
    "expo-build-properties": "~55.0.10",
    "expo-clipboard": "~55.0.17",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.15",
    "expo-modules-core": "^55.0.17",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "framed-stream": "^1.0.1",
    "hello-pear-worker": "^1.1.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2",
    "pear-mobile": "^4.3.0",
    "pear-runtime-react-native": "^3.0.1",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-bare-kit": "^0.12.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.84.0",
    "@types/react": "~19.2.10",
    "bare-pack": "^2.0.0",
    "lunte": "^1.6.0",
    "pear-build": "^1.2.0",
    "pear-link": "^5.0.1",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "bare-module-lexer": "1.6.5",
    "expo-asset": "~55.0.19"
  },
  "private": true
}
